# ================= DataHarvester 配置示例 =================
# 复制为 .env 后按需修改： cp .env.example .env

# 访问密码（必填）。首次启动前请设置一个足够长的随机密码。
APP_PASSWORD=请替换为一个至少16位的随机密码

# 进阶：也可以使用 PBKDF2 哈希替代明文密码（推荐）。
# 生成方式：python -m app.set_password "你的密码"
# 设置后请注释掉上面的 APP_PASSWORD。
# APP_PASSWORD_HASH=pbkdf2_sha256$260000$...$...

# 会话签名密钥（留空则自动生成到 data/secret.key）
# SECRET_KEY=

# 通过 HTTPS 反向代理访问时设为 true，Cookie 将只在 HTTPS 下发送
COOKIE_SECURE=false

# 是否允许抓取内网地址（默认 false，开启会带来 SSRF 风险，仅内网可信环境使用）
ALLOW_PRIVATE_NETWORK=false

# 数据目录（SQLite 与密钥文件）
DATA_DIR=./data

# 并发任务数、单任务最大页数、响应体大小上限（字节）、请求超时（秒）
MAX_CONCURRENT_JOBS=2
MAX_PAGES=20
MAX_BYTES=5000000
FETCH_TIMEOUT=25

# 单任务最大数据行数
MAX_ROWS=50000

# 期望站点管理员识别到的爬虫标识（建议留下联系方式）
# USER_AGENT=DataHarvester/1.0 (+mailto:you@example.com)
